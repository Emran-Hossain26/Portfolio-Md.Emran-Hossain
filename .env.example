# Copy to .env.local and fill the real values. Never commit real keys.

# Supabase (public-safe values used in the browser too)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never expose in browser code or public repos
SUPABASE_SERVICE_ROLE_KEY=

# Optional extra allowlist for /admin (the real check is public.is_admin())
ADMIN_EMAIL=

# Canonical site URL (your *.vercel.app now; the real domain later)
NEXT_PUBLIC_SITE_URL=
