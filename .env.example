# Copy to .env.local and fill the real values. Never commit real keys.

# Supabase (public-safe values used in the browser too)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never expose in browser code or public repos
SUPABASE_SERVICE_ROLE_KEY=

# Optional extra allowlist for /admin (the real check is public.is_admin())
ADMIN_EMAIL=

# Canonical site URL (your *.vercel.app now; the real domain later)
NEXT_PUBLIC_SITE_URL=

# Email notifications (Resend) — optional; without a key every email
# feature (quick reply, new-review alert, test email) silently no-ops.
# https://resend.com/api-keys  |  from: "Portfolio <you@yourdomain>"
RESEND_API_KEY=
RESEND_FROM=

# Cloudflare Turnstile (Stage 6 item 4) — site key is public, secret is server-only.
# Without keys: forms pass in development and are REJECTED in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
